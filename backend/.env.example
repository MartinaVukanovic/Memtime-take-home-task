NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

DATABASE_NAME=memtime
MONGODB_USER=memtime_app
MONGODB_HOST=memtime.hjedswt.mongodb.net
MONGODB_PASSWORD=replace-with-assignment-api-key

# Optional override (e.g. local MongoDB or tests). When set, MONGODB_PASSWORD is not required.
# MONGO_URL=mongodb://127.0.0.1:27017

API_KEY=replace-with-assignment-api-key

# Assignment API: 15 requests per 60 seconds, keyed by API key.
# Set to false when exercising the frontend locally (avoids 429s and local Redis).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=15
REDIS_URL=redis://127.0.0.1:6379
